function [m_final, state_final, avg_step_time, info] = run_hopfield( ...
        initial_state, pattern, weights, varargin)
% RUN_HOPFIELD
% Dinamica di Hopfield con mappatura neurone->pixel. Si arresta dopo
% max 1000 iterazioni oppure quando la magnetizzazione m(t) >= m(0)+0.05.
% Opzionalmente salva un video AVI dell’evoluzione dello stato.
%
% OUTPUT PRINCIPALE:
%   m_final : magnetizzazione finale rispetto a 'pattern'
%
% OUTPUT OPZIONALI:
%   state_final : stato finale [N_x x N_y]
%   info        : struct con .iters, .m0, .threshold, .stoppedBy, .videoFile, .last_h
%
% Opzioni (name-value):
%   'Verbose'   : false (default)
%   'SaveVideo' : false (default)  -> se true, salva un .avi dell’evoluzione
%   'VideoFile' : 'hopfield_evolution.avi' (default)
%   'FrameRate' : 20 (default)     -> fps del video
%
% Nota video: i frame sono in scala di grigi: -1 -> nero, +1 -> bianco.
    tol=1e-2;  % if magnetisations differ by this, they are considered equal
    
    % --- Parse opzioni
    p = inputParser;
    addRequired(p, 'initial_state', @(x)isnumeric(x) && ismatrix(x));
    addRequired(p, 'pattern',       @(x)isnumeric(x) && ismatrix(x));
    addRequired(p, 'weights',       @(x)isnumeric(x) && ismatrix(x));
    addParameter(p, 'Verbose',   false,   @(x)islogical(x)&&isscalar(x));
    addParameter(p, 'SaveVideo', false,   @(x)islogical(x)&&isscalar(x));
    addParameter(p, 'VideoFile', 'hopfield_evolution.avi', @(s)ischar(s)||isstring(s));
    addParameter(p, 'FrameRate', 20,      @(x)isnumeric(x)&&isscalar(x)&&x>0);
    parse(p,initial_state, pattern, weights, varargin{:});

    verbose   = p.Results.Verbose;
    saveVid   = p.Results.SaveVideo;
    videoFile = char(p.Results.VideoFile);
    fps       = p.Results.FrameRate;

    % --- Dimensioni e check
    [Nx, Ny] = size(initial_state);
    if ~isequal(size(pattern), [Nx, Ny])
        error('pattern deve avere la stessa dimensione di initial_state.');
    end
    N = Nx*Ny;

    % --- Stato iniziale e pattern in ±1
    s   = sign(initial_state(:)); s(s==0)=1;
    pat = sign(pattern(:));       pat(pat==0)=1;

    % --- Magnetizzazione iniziale e criteri stop
    m0        = mean(s .* pat);
    windowLen = 5
    maxIter   = 1000;

    stoppedBy = 'maxIter';
    lastIter  = 0;
    sumStepTime = 0.0;   % this will let us compute the average time to advance by one step 

    % --- Setup VideoWriter (opzionale)
    v = [];
    if saveVid
        try
            v = VideoWriter(videoFile, 'Motion JPEG AVI');
            v.FrameRate = fps;
            open(v);
            % Frame dello stato iniziale
            writeVideo(v, state_to_frame(reshape(s,[Nx,Ny])));
        catch ME
            warning('Impossibile aprire/scrivere il video (%s). Proseguo senza salvataggio.', ME.message);
            v = [];
            saveVid = false;
        end
    end

    % --- Iterazioni
    for it = 1:maxIter
        % Chiedi direttamente i SEGNI dei nuovi spin al calcolatore (usa la sua zero-rule interna)
        t0 = tic;
        s_new = weights*s;
        s_new = sign(s_new);     % in caso il calcolatore ritorni già ±1 resta invariato
        step_t = toc(t0);
        sumStepTime = sumStepTime + step_t;
        % Magnetizzazione corrente
        m = mean(s_new .* pat);
        if verbose
            fprintf('Iter %4d: m=%.5f \n', it, m);
        end

        % Salva frame aggiornato
        if saveVid && ~isempty(v)
            writeVideo(v, state_to_frame(reshape(s_new,[Nx,Ny])));
        end

        % Aggiorna stato e verifica stop
        s       = s_new;
        lastIter = it;

        if it >= windowLen
            recent = m_hist(it-windowLen+1:it);
            if max(recent) - min(recent) < tol
                stoppedBy = 'convergence';
                break;
            end
        end
    end

     % --- Tempo medio per step
    if lastIter > 0
        avg_step_time = sumStepTime / lastIter;
    else
        avg_step_time = NaN;
    end

    % --- Chiudi video se aperto
    if ~isempty(v)
        try, close(v); catch, end
    end

    % --- Calcola i campi locali finali (una volta sola) per riempire info.last_h
    h_final = weights*s;

    % --- Output
    m_final     = mean(s .* pat);
    state_final = reshape(s, [Nx, Ny]);

    info = struct();
    info.iters      = lastIter;
    info.m0         = m0;
    info.stoppedBy  = stoppedBy;    % 'threshold' oppure 'maxIter'
    info.last_h     = h_final(:);   % campi locali finali (ordinati come i neuroni)
    info.videoFile  = [];
    if saveVid, info.videoFile = videoFile; end
end

% =====================================================================
% Helper: converti stato ±1 in frame RGB uint8 MxNx3 (grayscale)
function frameRGB = state_to_frame(S)
    % S: matrice Nx×Ny con valori in {-1,+1}
    % Mappa -1 -> 0 (nero), +1 -> 255 (bianco)
    img = uint8( (S + 1) .* 127.5 );         % 0 o 255
    frameRGB = repmat(img, 1, 1, 3);         % truecolor MxNx3
end
